# Normalize line endings to LF in the repository for all text files.
# Git will convert to CRLF on Windows checkout but store LF in the repo.
* text=auto eol=lf

# Explicitly LF for source code
*.py    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.in    text eol=lf

# Binary files — never touch line endings
*.so    binary
*.pyd   binary
*.dll   binary
*.dylib binary
*.a     binary
*.lib   binary
*.whl   binary
*.png   binary
*.jpg   binary
